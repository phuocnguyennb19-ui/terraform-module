# Terraform
.terraform/
# NOTE: .terraform.lock.hcl is deliberately NOT ignored — it pins provider
# versions and checksums so CI resolves exactly what you resolved. Commit it.
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
tfplan
tfplan.json
tfplan-*
*.tfplan
*.tfplan.json

# The root reads config.yaml and backend.hcl copied in from the values
# repository (terraform-aws-platform). One environment's settings committed here
# would be living in the shared library.
/config.yaml
/config.yml
/backend.hcl

# Logs
*.log

# OS
.DS_Store
